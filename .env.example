# Vyapaar configuration. Copy to `.env` and fill in what you need.
# Every value below has a working default -- the demo runs end to end with an
# empty .env, using the local payment simulator and the deterministic planner.

# ---------------------------------------------------------------- service ---
VYAPAAR_ENV=local
API_HOST=127.0.0.1
API_PORT=8000
PUBLIC_BASE_URL=http://127.0.0.1:8000
WEB_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------ persistence ---
# DATABASE_PATH=./data/vyapaar.db
# SEED_PRODUCTS_PATH=./seed/products.json
# `hashing` needs no model download. `sentence-transformers` needs the extra:
#   pip install sentence-transformers
EMBEDDINGS_BACKEND=hashing

# --------------------------------------------------------------- merchant ---
MERCHANT_ID=merch_kirana_labs
MERCHANT_NAME=Kirana Labs Pvt Ltd

# ------------------------------------------------- mandates (AP2-style JWT) ---
# CHANGE THIS. Anyone holding the secret can mint mandates that spend money.
MANDATE_JWT_SECRET=dev-only-insecure-mandate-secret-change-me
MANDATE_JWT_ALG=HS256
MANDATE_ISSUER=vyapaar.mandate.v1
MANDATE_MAX_TTL_HOURS=720

# ------------------------------------------------------------- guardrails ---
# Purchases at or above this amount are held for a human. 500000 paise = INR 5,000.
HITL_THRESHOLD_PAISE=500000
MAX_QTY_PER_INTENT=10

# --------------------------------------------- payments (TEST MODE ONLY) ---
# Leave the keys blank to use the built-in simulator. Fill them in and the same
# code paths talk to real Razorpay test mode instead.
# The config layer REFUSES any key that does not start with rzp_test_.
PAYMENTS_MODE=auto
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured on the Razorpay webhook.
RAZORPAY_WEBHOOK_SECRET=dev-only-insecure-webhook-secret

# ------------------------------------------------------- agent LLM (free) ---
# auto = first provider with a key, else the deterministic planner.
LLM_PROVIDER=auto
# LLM_MODEL=gemini-2.0-flash
LLM_TIMEOUT_SECONDS=30
# https://aistudio.google.com/apikey  (free tier)
GEMINI_API_KEY=
# https://console.groq.com/keys  (free tier)
# Accepts a comma-separated pool. The client rotates on 429 and parks a
# rate-limited key until its reset window passes, so a burst of scenario
# runs does not drop the agent back to the deterministic planner.
#   GROQ_API_KEY=gsk_one,gsk_two,gsk_three
GROQ_API_KEY=
# Fully local alternative: `ollama serve`, then LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
